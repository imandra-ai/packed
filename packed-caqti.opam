# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Db-connection capability and transaction plumbing for Caqti"
description:
  "A first-class-module seam between repository code and Caqti: a Db_connection capability that is either a pool or an open transaction, uniform apply/with_tx over both, a unit-of-work with an unforgeable in-transaction witness, and a COALESCE-friendly update combinator. Extracted from imandra-web."
maintainer: [
  "Sebastian Provenzano <sebastian@imandra.ai>" "Imandra <tech@imandra.ai>"
]
authors: ["Sebastian Provenzano <sebastian@imandra.ai>"]
license: "MIT"
homepage: "https://github.com/imandra-ai/packed"
bug-reports: "https://github.com/imandra-ai/packed/issues"
depends: [
  "dune" {>= "3.8"}
  "ocaml" {>= "4.08"}
  "caqti" {>= "2.0" & < "2.2"}
  "caqti-lwt" {>= "2.0" & < "2.2"}
  "lwt"
  "packed-error" {= version}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/imandra-ai/packed.git"
x-maintenance-intent: ["(latest)"]
