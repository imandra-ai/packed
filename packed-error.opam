bug-reports: "https://github.com/imandra-ai/packed/issues"
depends: [
  "dune" {>= "3.8"}
  "ocaml" {>= "4.08"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/imandra-ai/packed.git"
x-maintenance-intent: ["(latest)"]
